{
  "name": "retro-rgp",
  "version": "0.2.0-alpha.7",
  "description": "A persistent party dungeon roguelike with a dedicated MCP rules server and HTML client",
  "type": "module",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/rogue-viewer.js",
    "rogue": "node scripts/rogue-viewer.js",
    "test": "node --test test/*.test.js",
    "audit:village": "node scripts/audit-village-simulation.js",
    "audit:village:proof": "node scripts/audit-village-simulation.js --prove --runs 10 --ticks 500 --checkpoints 0,100,250,500",
    "audit:village:survival": "node scripts/audit-village-simulation.js --survival",
    "audit:village:domestic": "node scripts/audit-village-simulation.js --domestic",
    "audit:village:scheduler": "node scripts/audit-village-simulation.js --scheduler",
    "audit:village:release": "node scripts/audit-village-simulation.js --release",
    "audit:village:full-town": "node scripts/audit-village-simulation.js --full-town --ticks 2400",
    "audit:function-lengths": "node scripts/audit-function-lengths.js",
    "audit:visuals": "node scripts/audit-village-visuals.js",
    "format": "prettier --write src scripts test viewer docs README.md CHANGELOG.md LICENSE.md NOTICE.md",
    "format:check": "prettier --check src scripts test viewer docs README.md CHANGELOG.md LICENSE.md NOTICE.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
